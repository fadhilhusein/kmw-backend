generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model Division {
  id               Int                    @id @default(autoincrement())
  name             String
  code             String                 @unique
  sentRequests     CrossDivisionRequest[] @relation("RequesterDiv")
  receivedRequests CrossDivisionRequest[] @relation("TargetDiv")
  projects         Project[]
  members          User[]

  @@map("divisions")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  nim            String   @unique
  email          String?  @unique
  password       String?
  role           Role     @default(STAFF)
  activationCode String?  @map("activation_code")
  isActive       Boolean  @default(false) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  divisionCode   String   @map("division_code")
  bills          Bill[]
  assignedTasks  Task[]
  division       Division @relation(fields: [divisionCode], references: [code])

  @@map("users")
}

model Project {
  id             Int                    @id @default(autoincrement())
  title          String
  startDate      DateTime               @map("start_date") @db.Date
  endDate        DateTime               @map("end_date") @db.Date
  leadDivisionId Int                    @map("lead_division_id")
  requests       CrossDivisionRequest[]
  leadDivision   Division               @relation(fields: [leadDivisionId], references: [id])
  tasks          Task[]

  @@map("projects")
}

model Task {
  id             Int                   @id @default(autoincrement())
  title          String
  status         TaskStatus            @default(TODO)
  dueDate        DateTime?             @map("due_date")
  projectId      Int                   @map("project_id")
  assignedUserId Int?                  @map("assigned_user_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  originRequest  CrossDivisionRequest?
  assignedUser   User?                 @relation(fields: [assignedUserId], references: [id])
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

model CrossDivisionRequest {
  id              Int           @id @default(autoincrement())
  description     String
  status          RequestStatus @default(PENDING)
  requesterDivId  Int           @map("requester_div_id")
  targetDivId     Int           @map("target_div_id")
  projectId       Int           @map("project_id")
  generatedTaskId Int?          @unique @map("generated_task_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  generatedTask   Task?         @relation(fields: [generatedTaskId], references: [id])
  project         Project       @relation(fields: [projectId], references: [id])
  requesterDiv    Division      @relation("RequesterDiv", fields: [requesterDivId], references: [id])
  targetDiv       Division      @relation("TargetDiv", fields: [targetDivId], references: [id])

  @@map("cross_division_requests")
}

model Bill {
  id        Int           @id @default(autoincrement())
  title     String
  amount    Int
  orderId   String        @unique @map("order_id")
  snapToken String?       @map("snap_token")
  status    PaymentStatus @default(PENDING)
  userId    Int           @map("user_id")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id])

  @@map("bills")
}

model ErrorLog {
  id              Int      @id @default(autoincrement())
  errorId         String   @unique @map("error_id")
  name            String
  message         String
  code            String?
  status          Int      @map("status_code")
  stackTrace      String?  @map("stack_trace")
  userId          Int?     @map("user_id")
  userRole        String?  @map("user_role")
  requestMethod   String?  @map("request_method")
  requestUrl      String?  @map("request_url")
  requestPath     String?  @map("request_path")
  requestIp       String?  @map("request_ip")
  userAgent       String?  @map("user_agent")
  context         Json?    // Additional context as JSON
  resolved        Boolean  @default(false)
  resolvedAt      DateTime? @map("resolved_at")
  resolvedBy      String?  @map("resolved_by")
  resolvedNote    String?  @map("resolved_note")
  count           Int      @default(1) // Number of times this error occurred
  firstOccurredAt  DateTime @default(now()) @map("first_occurred_at")
  lastOccurredAt  DateTime @default(now()) @map("last_occurred_at")

  @@index([errorId])
  @@index([name])
  @@index([status])
  @@index([userId])
  @@index([resolved])
  @@index([firstOccurredAt])
  @@index([lastOccurredAt])
  @@map("error_logs")
}

enum Role {
  KETUA
  MANAJER
  STAFF
  ADMIN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVISION
  DONE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}
