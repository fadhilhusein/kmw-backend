# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env.production and fill in your actual values
# DO NOT commit this file to version control!

# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/database"

# JWT Configuration - USE THIS SECURE SECRET
JWT_SECRET="5a30841364b224f78d5f9e0e1508437655f85d5362a898a1e3032b98aa4d17d1"

# Midtrans Configuration
MIDTRANS_SERVER_KEY="YOUR_PRODUCTION_MIDTRANS_SERVER_KEY"

# Frontend URL - UPDATE WITH YOUR PRODUCTION DOMAIN
FRONTEND_URL="https://your-frontend-url.vercel.app"

# Environment
NODE_ENV=production

# Logging Configuration
LOG_LEVEL=info              # trace, debug, info, warn, error
LOG_FILE_ENABLED=false       # Disable file logging in production (use external logging)
LOG_CONSOLE_ENABLED=true    # Enable console logging for debugging
LOG_RETENTION_DAYS=7        # Not used when file logging is disabled
ENABLE_MONITORING=true      # Enable performance monitoring
ENABLE_HEALTH_CHECK=true     # Enable periodic health checks

# Optional: Additional Security Settings
# MAX_REQUEST_SIZE=10mb     # Maximum request body size
# RATE_LIMIT_WINDOW=15      # Rate limiting window in minutes
# RATE_LIMIT_MAX=5         # Maximum requests per window for auth